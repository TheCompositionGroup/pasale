// Deploys Pásale as a Cloudflare Worker with static assets: `npx wrangler deploy`.
// Static files come from public/. The Worker answers /api/* and /sign only.
{
  "name": "pasale",
  "main": "adapters/worker.js",
  "compatibility_date": "2025-09-01",
  // Serve on https://<name>.<subdomain>.workers.dev, and no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/sign"]
  },
  // Plain settings. This copy is the public DEMO: it shows a banner and sends nothing.
  // For a real business set "DEMO_MODE" to "false" and add the secret RESEND_API_KEY
  // (Cloudflare dashboard > your Worker > Settings > Variables and Secrets).
  // Never put secrets in this file.
  "vars": {
    "DEMO_MODE": "true"
  },
  // Showcase: the Fancy Ape example, a fully customized page (see README). Deploy with
  // `npx wrangler deploy --env showcase`. Always DEMO_MODE: nothing is sent or saved.
  // Environments do not inherit settings, so they are repeated here. The build step copies
  // public/, the example's images and a read-only copy of its config into .showcase/public.
  "env": {
    "showcase": {
      "name": "pasale-showcase",
      "main": "adapters/worker-showcase.js",
      "workers_dev": true,
      "preview_urls": false,
      "build": { "command": "node scripts/build-showcase.js" },
      "assets": {
        "directory": "./.showcase/public",
        "run_worker_first": ["/api/*", "/sign"]
      },
      "vars": {
        "DEMO_MODE": "true"
      }
    }
  }
}
