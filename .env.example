# Secrets live here (Node server) or in your host's settings (Cloudflare Pages:
# Settings > Environment variables, as encrypted secrets). Never in the config file.

# Delivery type "resend": create a key at https://resend.com
RESEND_API_KEY=

# Delivery type "webhook": any URL that accepts a JSON POST
# (Make, Zapier, n8n, a Slack or Discord incoming webhook, your own server)
PASALE_WEBHOOK_URL=

# Optional: show a demo banner and send nothing
# DEMO_MODE=true

# Node server only
# PORT=3000
# PASALE_CONFIG=./config/pasale.config.js
